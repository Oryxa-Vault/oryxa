# Build output
/oryxa
/mockagent
/dist/
/target/
*.exe

# Local state
*.db
*.db-journal
*.sqlite
*.sqlite3

# Connectors are configuration and may point at internal hosts or carry
# credentials in headers. The templates and verified examples are tracked
# explicitly; anything else a user drops in is theirs.
#
# A connector that ships needs a line here as well as a file. Forgetting is
# silent — `git add -A` skips it, local tests pass against a file the checkout
# does not have, and CI is the first thing to notice.
/connectors/*
!/connectors/templates/
!/connectors/mock-*.yaml
!/connectors/langgraph.yaml
!/connectors/adk.yaml
!/connectors/pydanticai.yaml
!/connectors/crewai.yaml
# Both reach a shim on localhost and carry no credentials — what may actually
# run lives in shim.yaml, which is the file to think about before sharing.
!/connectors/claude-code.yaml
!/connectors/codex.yaml
!/connectors/claude-code-acp.yaml
!/connectors/codex-acp.yaml
# bee-agui.yaml stays local: it names a private internal service. The generic
# AG-UI template covers the same protocol for everyone else.

# Environment
.env
.env.*
!.env.example

# Compose overrides are local
docker-compose.override.yml

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local demo rig: connector sets and the switcher for recordings.
/demo/

# Recording rig: the scripts are tracked, the footage is not. Raw takes are tens
# of megabytes per run and the cut is rebuildable from them.
recording/node_modules/
recording/out/
recording/final/
