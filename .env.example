# Copy to .env. docker compose reads it automatically.

# Require a token for the API and viewer. Generate one:
#   openssl rand -hex 32
ORYXA_TOKEN=

# Take the acting user from a header your proxy already sets, so the log
# records people rather than claims. Only safe when nothing can reach Oryxa
# except that proxy.
#   ORYXA_TRUST_HEADER=X-Forwarded-User
ORYXA_TRUST_HEADER=

ORYXA_PORT=8080
POSTGRES_PASSWORD=oryxa

# Development only. Erases every session each time the server starts, so a
# restart gives you an empty board rather than every room you had finished with.
# This deletes the durable log — the thing replay, audit and recovery all read,
# including agents registered over the API rather than loaded from a file.
#   ORYXA_RESET=1
ORYXA_RESET=

# Connector that summarises long shared-context lists (see connectors/templates/summariser.yaml)
ORYXA_SUMMARISER=
